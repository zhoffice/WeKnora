@echo off
rem Load the offline images on the target machine and start WeKnora.
rem Generated by scripts/windows/package-windows.sh docker-bundle.
setlocal EnableExtensions
cd /d "%~dp0"

echo ^>^> docker load...
docker load -i images.tar || exit /b 1

if not exist ".env" (
    copy /y ".env.example" ".env" >nul
    echo ^>^> Created .env from .env.example. Change secrets and passwords before production use.
)

set "PROFILES="
set /p PROFILES=<profiles.txt
if defined PROFILES (
    set "COMPOSE_PROFILES=%PROFILES: =,%"
)
if defined COMPOSE_PROFILES echo ^>^> COMPOSE_PROFILES=%COMPOSE_PROFILES%

rem Images are local and the bundle has no sources, so never build.
docker compose up -d --no-build || exit /b 1
echo ^>^> Started: Web UI http://localhost  API http://localhost:8080
