# WeKnora 标准版（多人共享）Windows 配置。
# 首次双击 WeKnora.exe 时会复制本文件为 .env 并生成下方三个密钥，改好数据库/Redis 密码后再启动。
# 已在系统环境变量里设置的同名变量优先于本文件。值中含 $ 时用单引号包起来，例如 DB_PASSWORD='pa$$word'。
# 完整选项见仓库根目录 .env.example。

GIN_MODE=release
LOG_LEVEL=info
# 日志同时写到控制台和此文件；qdrant / docreader 的日志在 logs\ 下各自的文件里
LOG_PATH=logs/weknora.log

# ---- PostgreSQL（Windows 官方安装包即可，无需 pgvector / pg_search）----
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=WeKnora
# 启动时自动建表/升级；多个实例共用一个库时只让一个实例开启
AUTO_MIGRATE=true

# ---- Redis（流式输出 + 任务队列；需要 Redis 6.2+ 兼容服务，如 Memurai）----
STREAM_MANAGER_TYPE=redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=stream:

# ---- 向量检索：包内自带 Qdrant，QDRANT_HOST 指向本机时由 WeKnora.exe 自动启动 ----
# 数据在 data\qdrant；改用自己部署的 Qdrant 时把 QDRANT_HOST 改成对方地址
RETRIEVE_DRIVER=qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6334
QDRANT_REST_PORT=6333
QDRANT_COLLECTION=weknora_embeddings
QDRANT_USE_TLS=false

# ---- 文档解析：包内自带 docreader，DOCREADER_ADDR 指向本机时由 WeKnora.exe 自动启动 ----
DOCREADER_ADDR=127.0.0.1:50051
DOCREADER_TRANSPORT=grpc

# 设为 off 时不启动包内的 qdrant / docreader，全部由你自行运行
# WEKNORA_BUNDLED_SERVICES=off

# ---- 文件存储 ----
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=./data/files

# ---- 模型 ----
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- 账号 ----
# 所有人注册完成后可改为 true，关闭自助注册（转为邀请制）
DISABLE_REGISTRATION=false

# ---- 密钥：首次启动自动生成，之后不要改 ----
# 改 JWT_SECRET 会让所有人重新登录；改 SYSTEM_AES_KEY 会导致已保存的 API Key 无法解密
JWT_SECRET=
SYSTEM_AES_KEY=
SYSTEM_SIGNING_KEY=

# ---- 可选组件 ----
NEO4J_ENABLE=false
WEKNORA_SANDBOX_MODE=disabled
